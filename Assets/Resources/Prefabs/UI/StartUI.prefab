  m_text: "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\uC778\uB9C8\uC804\uC7C1\uC774
    \uBC1C\uBC1C\uD588\uACE0\n \n\uC5F0\uD569\uD558\uAE30\uB85C \uD55C \uC778\uAC04\uC655\uAD6D\uB4E4\uC740
    \r\n\r\n\uC8FC\uBCC0 \uBAAC\uC2A4\uD130\uB97C \uC18C\uD0D5\uD55C\uB2E4\uBA70\n\n\uC9C0\uC6D0\uC744
    \uBCF4\uB0B4\uC9C0 \uC54A\uACE0 \uC788\uB294 \uC0C1\uD669, \r\n\n\uC2E0\uD0C1\uBC1B\uC740
    \uC6A9\uC0AC\uB4E4\uC774 \uBD84\uC8FC\uD788 \uB9C8\uC655\uAD70\uC744 \n\n\uC800\uC9C0\uD558\uC9C0\uB9CC
    \uD55C\uACC4\uC5D0 \uBD80\uB52A\uD788\uAC8C \uB41C\uB2E4. \r\n\r\n\uC774 \uC18C\uC2DD\uC744
    \uC811\uD55C \uB85C\uB80C\uC655\uAD6D\uC740 \uC804\uC7C1\uB098\uBA74\n\n\uC81C\uC77C
    \uBA3C\uC800 \uD53C\uD574\uC785\uB294 \uC655\uAD6D\uC73C\uB85C\r\n\r\n\uC774
    \uC6A9\uC0AC \uC77C\uD589\uC744 \uB3D5\uACE0\uC790\n\n\uC120\uBD09\uC5D0 \uC11C\uAE30\uB85C
    \uD55C\uB2E4. \r\n\r\n<color=white>\uD50C\uB808\uC774\uC5B4\uB294 \uD55C \uAC00\uBB38\uC758
    \uADC0\uC871 \uC790\uB140\uB85C\n\n\uC601\uC9C0 \uAD00\uB9AC\uB97C \uD1B5\uD574
    \uC5BB\uC740 \uBB3C\uC790\uB85C \r\n\r\n\uC804\uD669\uC744 \uBC14\uAFD4 \n\n\uC6A9\uC0AC
    \uC77C\uD589\uC744 \uB3C4\uC640\uC57C \uD55C\uB2E4.</color>\n\n\n\n\n\n\n\n\n"
